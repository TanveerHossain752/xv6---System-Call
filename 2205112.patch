+uint64
+sys_trace(void)
+{
+  int syscall_num;
+
+  argint(0, &syscall_num);
+  if(syscall_num < 0)
+    return -1;
+
+  myproc()->trace_num = syscall_num;
+  return 0;
+}
+
+uint64
+sys_history(void)
+{
+  int syscall_num;
+  uint64 addr;
+
+  argint(0, &syscall_num);
+  argaddr(1, &addr);
+
+  return history(syscall_num, addr);
+}
