+
+static void
+print_syscall_args(int num, uint64 *raw, char strbuf[][MAXPATH])
+{
+  int j;
+  int printed = 0;
+
+  for(j = 0; j < MAXTRACEARGS; j++) {
+    if(argtypes[num][j] == ARG_NONE)
+      break;
+
+    if(printed)
+      printf(", ");
+    else
+      printed = 1;
+
+    switch(argtypes[num][j]) {
+      case ARG_INT:
+        printf("%d", (int)raw[j]);
+        break;
+      case ARG_PTR:
+        printf("%p", (void*)raw[j]);
+        break;
+      case ARG_STR:
+        printf("\"%s\"", strbuf[j]);
+        break;
+      default:
+        break;
+    }
+  }
+}
+
+
+static struct spinlock stat_lock[NELEM(syscalls)];
+static struct syscall_stat syscall_stats[NELEM(syscalls)];
+
+void
+syscallstatsinit(void)
+{
+  int i;
+  for(i = 0; i < NELEM(syscalls); i++) {
+    initlock(&stat_lock[i], syscallnames[i]);
+    syscall_stats[i].count = 0;
+    syscall_stats[i].accum_time = 0;
+    if (syscallnames[i])
+    {
+      safestrcpy(syscall_stats[i].syscall_name, syscallnames[i], sizeof(syscall_stats[i].syscall_name));
+    } 
+  }
+}
+static void
+record_syscall_stat(int num, uint elapsed_time)
+{
+  if(num < 0 || num >= NELEM(syscalls))
+    return;
+
+  acquire(&stat_lock[num]);
+  syscall_stats[num].count++;
+  syscall_stats[num].accum_time += elapsed_time;
+  release(&stat_lock[num]);
+}
+uint64
+history(int num, uint64 addr)
+{
+  struct proc *p = myproc();
+  struct syscall_stat st;
+
+  if(num < 0 || num >= NELEM(syscalls) || syscallnames[num] == 0)
+    return -1;
+  acquire(&stat_lock[num]);
+  st = syscall_stats[num];
+  release(&stat_lock[num]);
+
+  if(copyout(p->pagetable, addr, (char*)&st, sizeof(st)) < 0)
+    return -1;
+  return 0;
+}
